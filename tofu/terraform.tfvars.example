# akamai-dev-box — example variables
# Copy to terraform.tfvars and customise.
#
# region, instance_type, image, and username are all sourced automatically:
#   - region / instance_type / image  from ~/.config/linode-cli (then built-in fallbacks)
#   - username                         from your local $USER at apply time
# Only authorized_keys and root_pass are required here.

###############################################################################
# Required
###############################################################################

# SSH public keys for the non-root user (ed25519 recommended).
authorized_keys = [
  # "ssh-ed25519 AAAAC3Nz... you@example.com",
]

# Required by the Linode API. Not used for login (SSH key auth only).
# Generate with: openssl rand -base64 32
root_pass = "CHANGE_ME_TO_A_STRONG_PASSWORD_AT_LEAST_16_CHARS"

###############################################################################
# Optional — inherited from ~/.config/linode-cli / $USER when left unset
###############################################################################

# region        = "eu-west"          # London; falls back to linode-cli, then eu-west
# instance_type = "g6-standard-4"    # 4 vCPU / 8 GB / 160 GB
# image         = "linode/debian13"  # Default. Supported: debian13, debian12, ubuntu24.04, ubuntu22.04
# username      = "yourname"         # defaults to local $USER at apply time

###############################################################################
# Instance basics
###############################################################################

# instance_label  = ""       # defaults to <username>-dev-box
# hostname        = ""       # defaults to instance_label
# timezone        = "UTC"
# tags            = ["dev", "devbox", "k3s", "debian"]
# private_ip      = false
# backups_enabled = false

###############################################################################
# Firewall
###############################################################################

# create_firewall = true

# Restrict SSH to your own networks for production use.
# allowed_ssh_cidrs_ipv4 = ["203.0.113.10/32"]
# allowed_ssh_cidrs_ipv6 = ["2001:db8::1/128"]

# Open inbound 80/443 (off by default — VSCode tunnel covers most workflows).
# expose_web = false

# Open inbound 6443 for the k3s API (off by default — use kubeconfig_fetch_command).
# expose_k3s_api = false
# allowed_k3s_api_cidrs_ipv4 = ["203.0.113.10/32"]
# allowed_k3s_api_cidrs_ipv6 = []

###############################################################################
# Cloud-init toggles
###############################################################################

# extra_packages         = []
# install_docker         = true
# install_k3s            = true
# k3s_channel            = "stable"
# k3s_disable_components = ["traefik", "servicelb"]
# install_languages      = ["go", "node", "python", "rust"]
# install_claude_code    = true
# install_opencode       = true
# install_vscode_tunnel  = true
# vscode_tunnel_name     = ""   # defaults to hostname
# install_shell_stack    = true # zsh + omz + p10k + tmux + fzf/zoxide/eza/delta/gh/btop/ncdu
