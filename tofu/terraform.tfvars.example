# akamai-dev-box — example variables
# Copy to terraform.tfvars and customise.
#
# region, instance_type, image, and username are all sourced automatically:
#   - region / instance_type / image  from ~/.config/linode-cli (keys: region, type, image)
#                                     then built-in fallbacks: gb-lon / g6-standard-4 / linode/ubuntu26.04
#   - username                        from your local $USER at apply time
# Only authorized_keys and root_pass are required here.
#
# Export LINODE_TOKEN (or set linode_token below) before running tofu apply.

###############################################################################
# Required
###############################################################################

# SSH public keys for the non-root user (ed25519 recommended).
authorized_keys = [
  # "ssh-ed25519 AAAAC3Nz... you@example.com",
]

# Required by the Linode API. Not used for login (SSH key auth only).
# Generate with: openssl rand -base64 32
root_pass = "CHANGE_ME_TO_A_STRONG_PASSWORD_AT_LEAST_16_CHARS"

###############################################################################
# Optional — inherited from ~/.config/linode-cli / $USER when left unset
###############################################################################

# region        = "gb-lon"             # Falls back to linode-cli, then gb-lon
# instance_type = "g6-standard-4"      # 4 vCPU / 8 GB / 160 GB (default). Scale down: g6-standard-2 (4 GB)
# image         = "linode/ubuntu26.04" # Default. Also supported: any private/ image
# username      = "yourname"           # defaults to local $USER at apply time

###############################################################################
# Instance basics
###############################################################################

# instance_label  = ""       # defaults to <username>-dev-box
# hostname        = ""       # defaults to instance_label
# timezone        = "UTC"
# tags            = ["dev", "devbox", "ubuntu"]
# private_ip      = false
# backups_enabled = false

###############################################################################
# Firewall
###############################################################################

# create_firewall = true

# Restrict SSH to your own networks for production use.
# allowed_ssh_cidrs_ipv4 = ["203.0.113.10/32"]
# allowed_ssh_cidrs_ipv6 = ["2001:db8::1/128"]

###############################################################################
# Cloud-init
###############################################################################

# The full dev stack (zsh/oh-my-zsh/tmux/vim/git via dotfiles_repo, gh, code,
# mise, claude, opencode, kubectl, opentofu, docker, k3s disabled by default)
# is always installed. Use extra_packages to add more apt packages.
# extra_packages = []

# Dotfiles repo cloned to ~/.dotfiles and installed via
# `./install.sh --unattended --no-packages`. Set to "" to skip.
# dotfiles_repo = "https://github.com/idvoretskyi/dotfiles.git"

# Git identity written to ~/.gitconfig.local on the box (optional).
# git_user_name  = "Your Name"
# git_user_email = "you@example.com"

# Seed ~/.config/linode-cli/cli on the box with the token (opt-in).
# WARNING: grants full Linode account access from the box — use a scoped token.
# seed_linode_cli = false
