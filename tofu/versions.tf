terraform {
  required_version = ">= 1.0"

  required_providers {
    linode = {
      source  = "linode/linode"
      version = "~> 2.0"
    }
    external = {
      source  = "hashicorp/external"
      version = "~> 2.0"
    }
  }
}

provider "linode" {
  # API token can be set via LINODE_TOKEN environment variable
  # or explicitly via the token parameter
}
